{
  "name": "cosas-per",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#db/schema": "./api/src/db/schema.ts",
    "#db/*": "./api/src/db/*.ts",
    "#domain/*": "./api/src/domain/*.ts",
    "#routes/*": "./api/src/routes/*.ts",
    "#auth/*": "./api/src/auth/*.ts",
    "#mail/*": "./api/src/mail/*.ts",
    "#contracts": "./api/src/contracts.ts",
    "#events": "./api/src/events.ts",
    "#scheduler": "./api/src/scheduler.ts",
    "#test/db": "./api/src/test/db.ts",
    "#server": "./api/src/server.ts"
  },
  "scripts": {
    "dev": "vp dev",
    "build": "tsc && vp build",
    "preview": "vp preview",
    "zones": "vp exec node scripts/extract-zones.ts && vp fmt --write src/map/zones.ts src/map/scene.ts",
    "api": "vp exec node --env-file-if-exists=api/.env api/src/server.ts",
    "api:migrate": "vp exec node --env-file-if-exists=api/.env api/src/db/migrate.ts",
    "db:generate": "vp exec drizzle-kit generate --config api/drizzle.config.ts",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "smoke": "vp exec node scripts/smoke-journey.ts",
    "smoke:structure": "vp exec node scripts/structure-check.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@hono/zod-validator": "^0.9.1",
    "@solar-icons/react": "^2.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.1.7",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^0.31.11",
    "playwright-core": "^1.64.1",
    "pngjs": "^7.0.0",
    "typescript": "~6.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "packageManager": "pnpm@12.14.0"
}
