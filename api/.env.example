# Copy to api/.env and fill it in. Never commit a real .env.
# The API reads these through `node --env-file-if-exists=api/.env`.

# Postgres connection string used by the API and by the migrations.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/objetos_perdidos

# Port the API listens on.
PORT=3001

# The web origins allowed to call the API with the session cookie, comma separated.
# The origin is never a wildcard: the session travels in a cookie.
WEB_ORIGIN=http://localhost:5173

# Signs the session cookie. Use a long random value; rotating it logs everyone out.
SESSION_SECRET=change-me-to-a-long-random-string

# Peppers the release key hash so a leaked database cannot be brute forced.
RELEASE_KEY_PEPPER=change-me-to-a-long-random-string

# console prints the mail to stdout; smtp sends it through SMTP_URL.
MAIL_TRANSPORT=console

# Only used when MAIL_TRANSPORT=smtp, e.g. smtp://user:password@smtp.example.com:587
SMTP_URL=

# Sender address of every outgoing mail.
MAIL_FROM="Objetos Perdidos ITM <no-reply@itmorelia.edu.mx>"
